        "description": "Expected: 201. The price of a swap is always 0.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Introduction to Psychology\",\n  \"course\": \"PSY 101\",\n  \"note\": \"Swap for a MIS book.\",\n  \"condition\": \"Fair\",\n  \"offer\": \"swap\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
