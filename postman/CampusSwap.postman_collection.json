      "name": "List all books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        },
        "description": "Expected: 200 and an array of books."
      },
      "response": []
    },
    {
      "name": "Get one book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "1"
          ]
        },
        "description": "Expected: 200 and the book with id 1."
      },
      "response": []
    },
    {
      "name": "Get one book - not found",
      "request": {
