{
  "info": {
    "name": "CampusSwap API",
    "description": "MIS 457 team project. All requests for the CampusSwap books API.\n\nStart the server first: cd api, npm install, npm start. The data is in an array, so restarting the server resets it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
