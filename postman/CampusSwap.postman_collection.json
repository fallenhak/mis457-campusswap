          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        },
        "description": "Expected: 201 and the new book with its id.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Calculus: Early Transcendentals\",\n  \"course\": \"MATH 101\",\n  \"note\": \"8th edition, clean pages.\",\n  \"condition\": \"Good\",\n  \"offer\": \"sell\",\n  \"price\": 350\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
